---
import { summary } from '../data/tracker.ts';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Sierra Peaks Tracker',
  description = "A host-neutral static split-flap departure board tracking the 247 active Sierra peaks against SPS 29th Edition and Peakbagger lid 5051, with the owner's public completion overlay.",
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#0a0c10" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <title>{title}</title>
    <link rel="stylesheet" href="/styles/global.css" />
    <script src="/client/board.js" defer></script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="board-shell">
      <header class="site-header">
        <span class="station-meta">Departures · High Sierra</span>
        <h1 class="site-title">
          Sierra <span class="accent">Peaks</span> Section
        </h1>
        <div class="station-row summited-meta">
          <strong class="accent">{summary.done}</strong>
          <span> / {summary.total} SUMMITED</span>
        </div>
      </header>

      <main id="main">
        <slot />
      </main>
    </div>
  </body>
</html>
