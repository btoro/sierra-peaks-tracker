---
/**
 * Pilot 06 — peak detail page.
 *
 * Renders one peak's facts (SPS name/class/elevation, Peakbagger
 * name/range/elevation, SPS id, document position), its completion
 * status from the public cid=30050 overlay, and the N/E/S/W view selector.
 *
 * No-JS behaviour (baseline): the selected compass view (from ?view=,
 * defaulting to North) renders its panel statically. The four radios are
 * a native form that reloads with ?view=N|E|S|W when JS is off.
 *
 * JS behaviour (progressive): an inline script intercepts the radio form
 * and updates the view panel in place without a reload.
 *
 * No view geometry is published in the current dataset, so each panel
 * shows an honest placeholder (frozen §6 / silhouettes.md: no fake
 * silhouettes or ridges).
 */
import Layout from '../../layouts/Layout.astro';
import {
  peaks,
  toDisplayPeaks,
  classLabel,
  COMPASS_VIEWS,
  summary,
} from '../../data/tracker.ts';
import type { DisplayPeak } from '../../data/tracker.ts';

const display = toDisplayPeaks();

export function getStaticPaths() {
  return peaks.map((p) => ({
    params: { id: p.sps_id },
  }));
}

const { id } = Astro.params;
const peak = peaks.find((p) => p.sps_id === id);
const dp = display.find((d) => d.sps_id === id);
if (!peak || !dp) throw new Error(`unknown peak id: ${id}`);

const viewParam = Astro.url.searchParams.get('view')?.toUpperCase();
const viewKey: 'N' | 'E' | 'S' | 'W' =
  ['N', 'E', 'S', 'W'].includes(viewParam ?? '') ? (viewParam as 'N' | 'E' | 'S' | 'W') : 'N';
const activeView = COMPASS_VIEWS.find((v) => v.key === viewKey)!;

const done = peak.completion !== null;
const doneLabel = done
  ? `Completed ${peak.completion!.date}${peak.completion!.day_suffix ? ` (day ${peak.completion!.day_suffix})` : ''}`
  : 'Not completed yet';
const completionDate = done ? peak.completion!.date : '—';
const completionSuffix = done && peak.completion!.day_suffix ? peak.completion!.day_suffix : '—';
---

<Layout
  title={`${dp.sps_name} — Sierra Peaks Tracker`}
  description={`${dp.sps_name} (${dp.sps_elevation_raw} ft, class ${classLabel(dp.sps_class_raw)}): ${dp.area}. Sierra Peaks Tracker.`}
>
  <div class="detail-head">
    <a class="detail-back" href="/">← Back to the board</a>
    <p class="detail-sub">
      {dp.area} · SPS {dp.sps_id} · {dp.pb_range}
    </p>
    <h1 class="detail-title" id="peak-name">{dp.sps_name}</h1>
    {dp.pb_name !== dp.sps_name ? (
      <p class="detail-sub">Peakbagger spelling: {dp.pb_name}</p>
    ) : null}
    <span class={`status-chip${done ? ' is-done' : ''}`}>{doneLabel}</span>
  </div>

  <div class="detail-grid">
    <div class="fact-card">
      <h2>SPS 29th Edition</h2>
      <ul class="fact-list">
        <li><span class="k">Peak</span><span class="v">{dp.sps_name}</span></li>
        <li><span class="k">Elevation</span><span class="v">{dp.sps_elevation_raw} ft</span></li>
        <li><span class="k">Class</span><span class="v">{classLabel(dp.sps_class_raw)}</span></li>
        <li><span class="k">Area</span><span class="v">{dp.area}</span></li>
        <li><span class="k">SPS id</span><span class="v">{dp.sps_id}</span></li>
        <li><span class="k">Board position</span><span class="v">#{dp.displayOrder} of {summary.total}</span></li>
      </ul>
    </div>

    <div class="fact-card">
      <h2>Peakbagger lid 5051</h2>
      <ul class="fact-list">
        <li><span class="k">Peak</span><span class="v">{dp.pb_name}</span></li>
        <li><span class="k">Elevation</span><span class="v">{dp.pb_elevation_raw} ft</span></li>
        <li><span class="k">Range</span><span class="v">{dp.pb_range}</span></li>
        <li><span class="k">List position</span><span class="v">#{peak.pb_order}</span></li>
      </ul>
    </div>

    <div class="fact-card">
      <h2>Completion</h2>
      <ul class="fact-list">
        <li>
          <span class="k">Status</span>
          <span class="v">{done ? 'Completed' : 'Remaining'}</span>
        </li>
        <li>
          <span class="k">Date</span>
          <span class="v">{completionDate}</span>
        </li>
        <li>
          <span class="k">Day suffix</span>
          <span class="v">{completionSuffix}</span>
        </li>
        <li>
          <span class="k">Source</span>
          <span class="v">cid 30050 (public)</span>
        </li>
      </ul>
    </div>
  </div>

  <div class="compass">
    <h2>Peak views</h2>
    <p class="compass-note">
      Pick a facing direction. The current dataset carries no per-face view
      geometry, so each panel is an honest placeholder until a licensed
      geometry source is added.
    </p>

    <form
      class="view-group"
      id="view-form"
      method="get"
      action={`/peaks/${id}/`}
      aria-label="Choose a view direction"
    >
      {COMPASS_VIEWS.map((v) => (
        <div class="view-option">
          <input
            type="radio"
            id={`view-${v.key}`}
            name="view"
            value={v.key}
            checked={v.key === viewKey}
            aria-describedby="view-panel-desc"
          />
          <label class="view-label" for={`view-${v.key}`}>
            <span class="view-letter" aria-hidden="true">{v.key}</span>
            <span class="view-name">{v.label}</span>
          </label>
        </div>
      ))}
    </form>

    <div
      class="view-panel"
      id="view-panel"
      role="region"
      aria-live="polite"
      data-view={activeView.key}
    >
      <p class="view-panel-title" id="view-panel-title">{activeView.label}</p>
      <p id="view-panel-desc">{activeView.description}</p>
    </div>
  </div>

  <script>
    // Progressive enhancement: switch compass views without a reload.
    // Without JS the radios submit the native GET form (?view=N|E|S|W).
    (() => {
      const form = document.getElementById('view-form');
      const panel = document.getElementById('view-panel');
      const title = document.getElementById('view-panel-title');
      const desc = document.getElementById('view-panel-desc');
      if (!form || !panel || !title || !desc || !(form instanceof HTMLFormElement)) return;

      const views: Record<string, { label: string }> = {
        N: { label: 'North view' },
        E: { label: 'East view' },
        S: { label: 'South view' },
        W: { label: 'West view' },
      };
      const note =
        'Placeholder orientation — no view geometry is published for this ' +
        'peak in the current dataset. A real per-face view (angle, approach ' +
        'notes, or terrain profile) will appear here when a licensed geometry ' +
        'source is added; nothing is invented in the meantime.';

      form.addEventListener('submit', (e) => {
        e.preventDefault();
        const v = new FormData(form).get('view');
        if (!v || typeof v !== 'string' || !views[v]) return;
        panel.dataset.view = v;
        title.textContent = views[v].label;
        desc.textContent = note;
        // update URL without reload for shareability
        const url = new URL(window.location.href);
        url.searchParams.set('view', v);
        window.history.replaceState(null, '', url);
      });
    })();
  </script>
</Layout>
