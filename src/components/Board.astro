---
/**
 * Pilot 12 — the board resets to faithfully match the tracker, unfiltered.
 *
 * All 247 active peaks are rendered in one uninterrupted responsive grid.
 * No groups/sections, no filter form, no search, no result count — just the
 * canonical SPS document order.
 */
import { toDisplayPeaks } from '../data/tracker.ts';
import PeakCard from './PeakCard.astro';

const display = toDisplayPeaks();
---

<section class="board" id="board" aria-label="Peak board">
  <div class="flip-grid" role="list">
    {display.map((p) => (
      <PeakCard peak={p} />
    ))}
  </div>
</section>
